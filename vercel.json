{
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "loomr.net" }], "destination": "https://www.loomr.net/:path*", "permanent": true },
    { "source": "/rooms/:path*", "destination": "https://loomr-new.vercel.app/rooms/:path*", "permanent": false },
    { "source": "/giris", "destination": "https://loomr-new.vercel.app/giris", "permanent": false }
  ]
}
